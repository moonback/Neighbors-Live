# Copy to `.env` (root, read by the worker and docker compose) and `apps/web/.env.local`.
# `pnpm db:start` generates both automatically from `supabase status` when they are missing.

# --- Public (inlined in the browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Any MapLibre style JSON. OpenFreeMap is free and keyless; swap for MapTiler/Stadia in prod if needed.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Generate with: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key

# --- Server only (web route handlers + worker) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Direct Postgres connection used by the worker (LISTEN/NOTIFY + SKIP LOCKED).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:contact@example.org
# Random string used to hash IP addresses for login rate limiting (never stored raw).
IP_HASH_SALT=replace-with-32-random-chars

# --- Worker ---
WORKER_CONCURRENCY=1
FACE_BLUR_ENABLED=true
# No reliable open plate model is bundled: keep false unless you provide one (see docs/PRIVACY.md).
PLATE_BLUR_ENABLED=false
PLATE_MODEL_PATH=
